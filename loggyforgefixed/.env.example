# PostgreSQL connection string. Required for all member, subscription and studio data.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/loggyforge
# Optional: force SSL on/off (true | false). Remote databases use SSL automatically.
# DATABASE_SSL=true

# Owner-only admin portal. Use a new, unique password and secrets.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Required to encrypt Daraja and email API secrets before storing them in PostgreSQL.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Public deployed URL; used to prefill the Daraja STK callback URL in Admin → Payments & Daraja.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Vercel Blob (uploads for downloads and the logo). Vercel adds this automatically when you connect
# a Blob store: Vercel → Storage → Create → Blob → connect it to this project. Do not commit a real token.
# BLOB_READ_WRITE_TOKEN=
